# ==================== Browser Use Cloud API ====================
# API key lay tai: https://cloud.browser-use.com (Settings > API Keys)
BROWSER_USE_API_KEY=your_api_key_here

# Base URL cua Browser Use Cloud API (API v4)
BROWSER_USE_BASE_URL=https://api.browser-use.com/api/v4

# Model cho agent (bo trong de dung default cua API, vi du: gpt-5.6-luna)
BROWSER_USE_MODEL=

# ======================== Server ========================
PORT=3000

# CORS: '*' cho phep moi origin, hoac chi dinh rieng vi du: https://example.com
CORS_ORIGIN=*

# ==================== Xu ly task ====================
# Tan suat poll trang thai run (ms)
POLL_INTERVAL_MS=2000

# Thoi gian toi da cho run hoan thanh (ms) - mac dinh 5 phut
TASK_TIMEOUT_MS=300000

# Gioi han dung luong file upload (bytes) - mac dinh 10MB (toi da 50MB theo Browser Use)
MAX_FILE_SIZE_BYTES=10485760