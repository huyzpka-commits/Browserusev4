# ==================== Browser Use Cloud API ====================
# API key lay tai: https://cloud.browser-use.com (Settings > API Keys)
BROWSER_USE_API_KEY=your_api_key_here

# Base URL cua Browser Use Cloud API (API v4)
BROWSER_USE_BASE_URL=https://api.browser-use.com/api/v4

# Model cho agent (bo trong de dung default cua API, vi du: gpt-5.6-luna)
BROWSER_USE_MODEL=

# ======================== Server ========================
PORT=3000

# CORS: '*' cho phep moi origin, hoac chi dinh rieng vi du: https://example.com
CORS_ORIGIN=*

# ==================== Xu ly task ====================
# Tan suat poll trang thai run (ms)
POLL_INTERVAL_MS=2000

# Timeout 2 TANG:
# - TASK_TIMEOUT_MS (mem, mac dinh 15 phut): qua nguong chi hien canh bao "dang lau hon du kien" roi TIEP TUC cho
# - TASK_HARD_TIMEOUT_MS (cung, mac dinh 30 phut): job moi dung voi loi 504
TASK_TIMEOUT_MS=900000
TASK_HARD_TIMEOUT_MS=1800000

# ==================== Upload file ====================
# Gioi han dung luong file upload (bytes) - mac dinh 10MB (toi da 50MB theo Browser Use)
MAX_FILE_SIZE_BYTES=10485760

# Gioi han giai nen ZIP: so file va tong dung luong sau giai nen
MAX_ZIP_FILES=50
MAX_ZIP_TOTAL_EXTRACT_BYTES=104857600

# ==================== Ket qua tai ve ====================
# Thu muc luu file ket qua (mac dinh: outputs/). File <jobId>.txt va <jobId>.json
# duoc tao sau moi job hoan thanh, UI hien link tai ve. Bo trong = dung outputs/
OUTPUT_DIR=
# Thoi gian giu file ket qua truoc khi tu dong xoa (ms) - mac dinh 24 gio
OUTPUT_FILE_TTL_MS=86400000